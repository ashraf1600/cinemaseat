# ============================================================================
# cinemaseat — local environment variables
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# All variables below are read by `config/settings.py`.
# ============================================================================

# ---- Django core -----------------------------------------------------------
# A long, random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=django-insecure-replace-me-in-production
# "True" / "False" — must be False in production.
DJANGO_DEBUG=False
# Comma-separated list. Use "*" only for trusted local debugging.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=cinemaseat
POSTGRES_USER=cinemaseat
POSTGRES_PASSWORD=cinemaseat
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Cinemaseat-specific ---------------------------------------------------
# How long a seat hold stays valid before it is released. The value is an
# integer number of seconds. **This MUST be supplied via env** so that judges
# can override it during automated tests (see `config/settings.py`).
HOLD_TTL_SECONDS=120

# Base URL of the upstream payment gateway. Used by the payments app to
# initiate and verify transactions.
GATEWAY_BASE_URL=http://gateway:9000