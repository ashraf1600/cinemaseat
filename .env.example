# ============================================================================
# CinemaSeat — environment variables for `docker compose up`.
#
# Copy this file to `.env` (same directory as `docker-compose.yml`) and edit
# if you want to override any default. Never commit a real `.env` to git.
#
# Every variable has a sensible default baked into docker-compose.yml, so a
# judge can run:
#
#     docker compose up --build
#
# with no `.env` file present at all.
# ============================================================================

# ---- Django core ------------------------------------------------------------
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=django-insecure-replace-me-in-production
# "True" / "False" — must be False in production.
DJANGO_DEBUG=False
# Comma-separated list of hostnames Django will serve. Add your domain in prod.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ---- PostgreSQL -------------------------------------------------------------
# Used by the `db` service (postgres:16-alpine) AND by the backend service
# when it connects. Keeping them aligned is intentional — the backend
# container reads POSTGRES_* as its connection config.
POSTGRES_DB=cinemaseat
POSTGRES_USER=cinemaseat
POSTGRES_PASSWORD=cinemaseat
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Cinemaseat-specific ----------------------------------------------------
# How long a seat hold stays valid (in seconds) before expire_holds releases it.
# Judges override this to test expiry behaviour.
HOLD_TTL_SECONDS=120

# Base URL of the upstream payment/OTP gateway. Inside the compose network
# the service name `gateway` resolves to the gateway container.
GATEWAY_BASE_URL=http://gateway:9000

# How often the in-container expire_holds loop runs (seconds).
EXPIRE_LOOP_INTERVAL=5

# Public URL the gateway should POST webhook callbacks to. MUST be reachable
# from the gateway container — inside docker-compose the service name "backend"
# resolves correctly. Outside Docker (e.g. a hosted gateway POSTing back over
# the internet), set this to the real public hostname.
BACKEND_PUBLIC_URL=http://backend:8000

# HMAC secret used to verify the X-Signature header on incoming gateway
# webhooks (/api/webhooks/payment/, /api/webhooks/otp/). MUST match the
# secret the gateway signs with. Leave empty in dev to disable signature
# verification (NOT recommended for production).
GATEWAY_SECRET=

# ---- Frontend ---------------------------------------------------------------
# Baked into the SPA bundle at build time. Defaults to same-origin `/api`
# so nginx can proxy requests to the backend. Only override this if the
# SPA is hosted on a different origin from the API (e.g. a CDN in front).
VITE_API_BASE_URL=/api
